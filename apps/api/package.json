{
  "name": "@retail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de aplicación: cuentas, catálogo, perfil, favoritos, carrito, pedidos y privacidad.",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/server.ts",
    "start": "NODE_OPTIONS=--experimental-sqlite tsx src/server.ts",
    "test": "NODE_OPTIONS=--experimental-sqlite node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@retail/style-engine": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
