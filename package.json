{
  "name": "monrepos-retail",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de probador virtual 3D y asesor de estilo por IA para retail de moda",
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @retail/web dev",
    "dev:api": "pnpm --filter @retail/api dev",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
